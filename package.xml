<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" type="application/xml"?>
<package format="3">
  <name>formation_control</name>
  <version>0.1.0</version>
  <description>Multi-robot formation control on ROSMASTER-X3 hardware</description>
  <maintainer email="mail@joelmccandless.com">Joel McCandless</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
